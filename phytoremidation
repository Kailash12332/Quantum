        "# ============================================================\n",
        "# CALHOUN COUNTY, ALABAMA\n",
        "# SOIL HEAVY METAL DATA CLEANING\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from google.colab import files\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. UPLOAD EXCEL FILE\n",
        "# ------------------------------------------------------------\n",
        "uploaded = files.upload()\n",
        "\n",
        "filename = list(uploaded.keys())[0]\n",
        "print(\"Uploaded file:\", filename)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. READ DATA\n",
        "# ------------------------------------------------------------\n",
        "df = pd.read_excel(filename, sheet_name=\"Calhoun_Soil_Metals\")\n",
        "\n",
        "print(\"\\nOriginal data:\")\n",
        "display(df)\n",
        "\n",
        "print(\"\\nOriginal shape:\", df.shape)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. CLEAN COLUMN NAMES\n",
        "# ------------------------------------------------------------\n",
        "df.columns = (\n",
        "    df.columns\n",
        "    .str.strip()\n",
        "    .str.lower()\n",
        "    .str.replace(\" \", \"_\")\n",
        "    .str.replace(\"/\", \"_\", regex=False)\n",
        "    .str.replace(\"(\", \"\", regex=False)\n",
        "    .str.replace(\")\", \"\", regex=False)\n",
        "    .str.replace(\"?\", \"\", regex=False)\n",
        ")\n",
        "\n",
        "print(\"\\nCleaned column names:\")\n",
        "print(df.columns.tolist())\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. REMOVE EXTRA SPACES FROM TEXT COLUMNS\n",
        "# ------------------------------------------------------------\n",
        "text_columns = df.select_dtypes(include=\"object\").columns\n",
        "\n",
        "for col in text_columns:\n",
        "    df[col] = df[col].astype(str).str.strip()\n",
        "\n",
        "# Convert artificial \"nan\" strings back to missing values\n",
        "df = df.replace([\"nan\", \"NaN\", \"NA\", \"N/A\", \"\"], np.nan)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. CONVERT CONCENTRATION COLUMNS TO NUMERIC\n",
        "# ------------------------------------------------------------\n",
        "df[\"concentration_mg_kg\"] = pd.to_numeric(\n",
        "    df[\"concentration_mg_kg\"],\n",
        "    errors=\"coerce\"\n",
        ")\n",
        "\n",
        "df[\"epa_background_mg_kg\"] = pd.to_numeric(\n",
        "    df[\"epa_background_mg_kg\"],\n",
        "    errors=\"coerce\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. REMOVE DUPLICATES\n",
        "# ------------------------------------------------------------\n",
        "df = df.drop_duplicates()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. CREATE ABOVE-BACKGROUND VARIABLE\n",
        "# ------------------------------------------------------------\n",
        "df[\"above_background\"] = np.where(\n",
        "    df[\"concentration_mg_kg\"] > df[\"epa_background_mg_kg\"],\n",
        "    \"Yes\",\n",
        "    \"No\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. CALCULATE CONCENTRATION / BACKGROUND RATIO\n",
        "# ------------------------------------------------------------\n",
        "df[\"background_ratio\"] = (\n",
        "    df[\"concentration_mg_kg\"] /\n",
        "    df[\"epa_background_mg_kg\"\n",
        "])\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. CREATE SIMPLE HOTSPOT INDICATOR\n",
        "# ------------------------------------------------------------\n",
        "df[\"hotspot\"] = np.where(\n",
        "    df[\"background_ratio\"] > 1,\n",
        "    \"Yes\",\n",
        "    \"No\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. CREATE WIDE FORMAT\n",
        "#     ONE ROW = ONE SOIL SAMPLE\n",
        "# ------------------------------------------------------------\n",
        "wide = df.pivot_table(\n",
        "    index=[\n",
        "        \"county\",\n",
        "        \"state\",\n",
        "        \"city_area\",\n",
        "        \"site\",\n",
        "        \"sample_id\"\n",
        "    ],\n",
        "    columns=\"symbol\",\n",
        "    values=\"concentration_mg_kg\",\n",
        "    aggfunc=\"first\"\n",
        ").reset_index()\n",
        "\n",
        "# Remove pivot column name\n",
        "wide.columns.name = None\n",
        "\n",
        "# Rename metal columns\n",
        "wide = wide.rename(columns={\n",
        "    \"As\": \"As_mgkg\",\n",
        "    \"Co\": \"Co_mgkg\",\n",
        "    \"Pb\": \"Pb_mgkg\"\n",
        "})\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 11. ADD EPA BACKGROUND VALUES\n",
        "# ------------------------------------------------------------\n",
        "wide[\"As_background_mgkg\"] = 16\n",
        "wide[\"Co_background_mgkg\"] = 16\n",
        "wide[\"Pb_background_mgkg\"] = 39\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 12. CREATE HOTSPOT VARIABLES FOR EACH METAL\n",
        "# ------------------------------------------------------------\n",
        "if \"As_mgkg\" in wide.columns:\n",
        "    wide[\"As_hotspot\"] = np.where(\n",
        "        wide[\"As_mgkg\"].notna(),\n",
        "        np.where(wide[\"As_mgkg\"] > 16, \"Yes\", \"No\"),\n",
        "        None\n",
        "    )\n",
        "\n",
        "if \"Co_mgkg\" in wide.columns:\n",
        "    wide[\"Co_hotspot\"] = np.where(\n",
        "        wide[\"Co_mgkg\"].notna(),\n",
        "        np.where(wide[\"Co_mgkg\"] > 16, \"Yes\", \"No\"),\n",
        "        None\n",
        "    )\n",
        "\n",
        "if \"Pb_mgkg\" in wide.columns:\n",
        "    wide[\"Pb_hotspot\"] = np.where(\n",
        "        wide[\"Pb_mgkg\"].notna(),\n",
        "        np.where(wide[\"Pb_mgkg\"] > 39, \"Yes\", \"No\"),\n",
        "        None\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 13. SORT DATA\n",
        "# ------------------------------------------------------------\n",
        "wide = wide.sort_values(\"sample_id\").reset_index(drop=True)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 14. DISPLAY CLEANED DATA\n",
        "# ------------------------------------------------------------\n",
        "print(\"\\n======================================\")\n",
        "print(\"CLEANED LONG-FORM DATA\")\n",
        "print(\"======================================\")\n",
        "display(df)\n",
        "\n",
        "print(\"\\n======================================\")\n",
        "print(\"GIS / ML READY WIDE DATA\")\n",
        "print(\"======================================\")\n",
        "display(wide)\n",
        "\n",
        "print(\"\\nNumber of unique samples:\", wide[\"sample_id\"].nunique())\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 15. MISSING VALUE SUMMARY\n",
        "# ------------------------------------------------------------\n",
        "print(\"\\nMissing values:\")\n",
        "display(wide.isnull().sum().to_frame(\"Missing_Count\"))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 16. DESCRIPTIVE STATISTICS\n",
        "# ------------------------------------------------------------\n",
        "metal_columns = [\n",
        "    col for col in [\"As_mgkg\", \"Co_mgkg\", \"Pb_mgkg\"]\n",
        "    if col in wide.columns\n",
        "]\n",
        "\n",
        "print(\"\\nHeavy metal descriptive statistics:\")\n",
        "display(wide[metal_columns].describe())\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 17. SAVE CLEANED EXCEL FILE\n",
        "# ------------------------------------------------------------\n",
        "output_file = \"Calhoun_County_Heavy_Metals_CLEANED.xlsx\"\n",
        "\n",
        "with pd.ExcelWriter(output_file, engine=\"openpyxl\") as writer:\n",
        "\n",
        "    df.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Clean_Long_Data\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    wide.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"GIS_ML_Ready\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "print(\"\\nCleaning completed successfully!\")\n",
        "print(\"Saved as:\", output_file)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 18. DOWNLOAD CLEANED FILE\n",
        "# ------------------------------------------------------------\n",
        "files.download(output_file)"
      ]
    },

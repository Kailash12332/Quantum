        "import folium\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# Inspect columns to see if we have latitude/longitude columns or need to parse them\n",
        "print(\"Columns in combined_wide:\", combined_wide.columns.tolist())\n",
        "\n",
        "# Look for lat/lon columns dynamically\n",
        "lat_col = next((c for c in combined_wide.columns if 'lat' in c or 'y_coord' in c), None)\n",
        "lon_col = next((c for c in combined_wide.columns if 'lon' in c or 'long' in c or 'x_coord' in c), None)\n",
        "\n",
        "# Fallback coordinate centroids for Alabama counties if exact coordinates aren't mapped\n",
        "county_coords = {\n",
        "    'calhoun': [33.7715, -85.8260],\n",
        "    'macon': [32.3789, -85.6922],\n",
        "    'mobile': [30.6897, -88.1714],\n",
        "    'jefferson': [33.5517, -86.8965]\n",
        "}\n",
        "\n",
        "if lat_col and lon_col:\n",
        "    print(f\"Using coordinate columns: {lat_col}, {lon_col}\")\n",
        "    map_df = combined_wide.dropna(subset=[lat_col, lon_col])\n",
        "else:\n",
        "    print(\"Coordinates not directly found in the dataset. Mapping using County Centroids and jittering points for visualization.\")\n",
        "    map_df = combined_wide.copy()\n",
        "    # Ensure we have clean lowercase county names\n",
        "    map_df['county_clean'] = map_df['county'].astype(str).str.strip().str.lower()\n",
        "\n",
        "    # Assign coordinates based on county centroids with a small random jitter so markers don't overlap\n",
        "    np.random.seed(42)\n",
        "    map_df['lat'] = map_df['county_clean'].map(lambda x: county_coords.get(x, [32.7794, -86.8287])[0] + np.random.uniform(-0.08, 0.08))\n",
        "    map_df['lon'] = map_df['county_clean'].map(lambda x: county_coords.get(x, [32.7794, -86.8287])[1] + np.random.uniform(-0.08, 0.08))\n",
        "    lat_col, lon_col = 'lat', 'lon'\n",
        "\n",
        "# Initialize Map centered around Alabama\n",
        "m = folium.Map(location=[32.7794, -86.8287], zoom_start=7, tiles='OpenStreetMap')\n",
        "\n",
        "# Add Markers\n",
        "for idx, row in map_df.iterrows():\n",
        "    county_name = row.get('county', 'Unknown')\n",
        "    location_desc = row.get('location', row.get('site', 'No Description'))\n",
        "    sample_id = row.get('sample_id', 'N/A')\n",
        "\n",
        "    # Determine popup text and color based on metals\n",
        "    popup_text = f\"<b>County:</b> {county_name}<br><b>Sample ID:</b> {sample_id}<br><b>Site:</b> {location_desc}\"\n",
        "\n",
        "    # Add marker\n",
        "    folium.Marker(\n",
        "        location=[row[lat_col], row[lon_col]],\n",
        "        popup=folium.Popup(popup_text, max_width=300),\n",
        "        tooltip=f\"{county_name} - {sample_id}\",\n",
        "        icon=folium.Icon(color='red', icon='info-sign')\n",
        "    ).add_to(m)\n",
        "\n",
        "# Save map as HTML and display\n",
        "m.save(\"alabama_heavy_metals_map.html\")\n",
        "display(m)"

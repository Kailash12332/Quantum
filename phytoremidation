      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "from google.colab import files\n",
        "\n",
        "# Define file paths for the 4 counties\n",
        "calhoun_file = \"/content/Calhoun_County_Heavy_Metals_CLEANED.xlsx\"\n",
        "macon_file = \"/content/Macon_County_Heavy_Metal_CLEANED.xlsx\"\n",
        "mobile_file = \"/content/Mobile_County_Heavy_Metals_CLEANED.xlsx\"\n",
        "jefferson_file = \"/content/Jefferson_County_Heavy_Metals_CLEAN.csv\"\n",
        "\n",
        "def load_sheets(filepath):\n",
        "    xl = pd.ExcelFile(filepath)\n",
        "    sheets = xl.sheet_names\n",
        "\n",
        "    # Attempt to load by name, otherwise fallback to index 0 and 1\n",
        "    long_sheet = \"Clean_Long_Data\" if \"Clean_Long_Data\" in sheets else sheets[0]\n",
        "    wide_sheet = \"GIS_ML_Ready\" if \"GIS_ML_Ready\" in sheets else (sheets[1] if len(sheets) > 1 else sheets[0])\n",
        "\n",
        "    print(f\"Loading {filepath}: Long='{long_sheet}', Wide='{wide_sheet}'\")\n",
        "    df_long = pd.read_excel(filepath, sheet_name=long_sheet)\n",
        "    df_wide = pd.read_excel(filepath, sheet_name=wide_sheet)\n",
        "    return df_long, df_wide\n",
        "\n",
        "# 1. Load Calhoun Data\n",
        "calhoun_long, calhoun_wide = load_sheets(calhoun_file)\n",
        "\n",
        "# 2. Load Macon Data\n",
        "macon_long, macon_wide = load_sheets(macon_file)\n",
        "\n",
        "# 3. Load Mobile Data\n",
        "mobile_long, mobile_wide = load_sheets(mobile_file)\n",
        "\n",
        "# 4. Load Jefferson Data (CSV-based, we will conform it)\n",
        "jefferson_data = pd.read_csv(jefferson_file)\n",
        "if \"county\" not in jefferson_data.columns:\n",
        "    jefferson_data[\"county\"] = \"Jefferson\"\n",
        "if \"state\" not in jefferson_data.columns:\n",
        "    jefferson_data[\"state\"] = \"Alabama\"\n",
        "\n",
        "# Clean column headers for consistency across all datasets\n",
        "for df_temp in [calhoun_long, calhoun_wide, macon_long, macon_wide, mobile_long, mobile_wide, jefferson_data]:\n",
        "    df_temp.columns = df_temp.columns.str.strip().str.lower()\n",
        "\n",
        "# Combine Long-Form Datasets\n",
        "combined_long = pd.concat([calhoun_long, macon_long, mobile_long], ignore_index=True)\n",
        "\n",
        "# Combine Wide-Form Datasets\n",
        "combined_wide = pd.concat([calhoun_wide, macon_wide, mobile_wide], ignore_index=True)\n",
        "\n",
        "# Display combined dataset metrics\n",
        "print(\"=== Combined Long Form Shape ===\")\n",
        "print(combined_long.shape)\n",
        "print(\"\\n=== Combined Wide Form Shape ===\")\n",
        "print(combined_wide.shape)\n",
        "\n",
        "# Save combined dataset\n",
        "combined_output_file = \"Alabama_Four_Counties_Heavy_Metals_COMBINED.xlsx\"\n",
        "with pd.ExcelWriter(combined_output_file, engine=\"openpyxl\") as writer:\n",
        "    combined_long.to_excel(writer, sheet_name=\"Combined_Long_Data\", index=False)\n",
        "    combined_wide.to_excel(writer, sheet_name=\"Combined_Wide_Data\", index=False)\n",
        "\n",
        "print(f\"\\nConsolidated dataset saved as: {combined_output_file}\")\n",
        "files.download(combined_output_file)"
      ],

        "\n",
        "# Map technical column names to reader-friendly labels\n",
        "metal_labels = {\n",
        "    'as_mgkg': 'Arsenic (As)',\n",
        "    'co_mgkg': 'Cobalt (Co)',\n",
        "    'pb_mgkg': 'Lead (Pb)'\n",
        "}\n",
        "melted_df['Metal'] = melted_df['Metal'].map(metal_labels)\n",
        "\n",
        "# Create subplots for each metal to handle distinct scaling differences\n",
        "fig, axes = plt.subplots(1, 3, figsize=(18, 6), sharey=False)\n",
        "metals = ['Arsenic (As)', 'Cobalt (Co)', 'Lead (Pb)']\n",
        "colors = ['#E76F51', '#2A9D8F', '#264653']\n",
        "\n",
        "for i, metal in enumerate(metals):\n",

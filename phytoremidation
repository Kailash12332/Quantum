        "\n",
        "# ============================================================\n",
        "# ALABAMA SOIL METAL CONCENTRATION DATA CLEANING\n",
        "# Research: Heavy Metals and Phytoremediation in Alabama\n",
        "# Google Colab - Complete Code\n",
        "# ============================================================\n",
        "\n",
        "!pip -q install pandas openpyxl\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import re\n",
        "from google.colab import files\n",
        "\n",
        "# ============================================================\n",
        "# STEP 1: UPLOAD EXCEL FILE\n",
        "# ============================================================\n",
        "\n",
        "print(\"Upload your Alabama soil metal Excel file\")\n",
        "\n",
        "uploaded = files.upload()\n",
        "file_name = next(iter(uploaded.keys()))\n",
        "\n",
        "excel_file = pd.ExcelFile(file_name)\n",
        "\n",
        "print(\"\\nUploaded file:\", file_name)\n",
        "print(\"Available worksheets:\", excel_file.sheet_names)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 2: DEFINE CLEANING FUNCTIONS\n",
        "# ============================================================\n",
        "\n",
        "def clean_column_name(name):\n",
        "    name = str(name).strip().lower()\n",
        "    name = re.sub(r\"[^a-z0-9]+\", \"_\", name)\n",
        "    return name.strip(\"_\")\n",
        "\n",
        "\n",
        "def clean_text(value):\n",
        "    if pd.isna(value):\n",
        "        return np.nan\n",
        "\n",
        "    value = str(value).strip()\n",
        "\n",
        "    if value.lower() in [\n",
        "        \"\", \"nan\", \"none\", \"n/a\", \"na\"\n",
        "    ]:\n",
        "        return np.nan\n",
        "\n",
        "    return value\n",
        "\n",
        "\n",
        "def parse_measurement(value):\n",
        "    \"\"\"\n",
        "    Returns:\n",
        "    numeric_value, qualifier, significance_letters,\n",
        "    extraction_efficiency_percent\n",
        "\n",
        "    Examples:\n",
        "    138b (21.3) -> 138, measured, b, 21.3\n",
        "    5.9A, ab    -> 5.9, measured, A, ab, no efficiency\n",
        "    <0.01       -> NaN, below_detection_limit\n",
        "    \"\"\"\n",
        "\n",
        "    if pd.isna(value):\n",
        "        return np.nan, \"missing\", \"\", np.nan\n",
        "\n",
        "    if isinstance(value, (int, float)):\n",
        "        return float(value), \"measured\", \"\", np.nan\n",
        "\n",
        "    s = str(value).strip().replace(\",\", \"\")\n",
        "\n",
        "    if s.lower() in [\n",
        "        \"\", \"na\", \"n/a\", \"nan\", \"none\", \"-\", \"nd\",\n",
        "        \"not detected\"\n",
        "    ]:\n",
        "        return np.nan, \"missing_or_not_detected\", \"\", np.nan\n",
        "\n",
        "    if s.startswith((\"<\", \">\", \"≤\", \"≥\")):\n",
        "        return np.nan, \"censored_\" + s[0], \"\", np.nan\n",
        "\n",
        "    pattern = (\n",
        "        r\"^([-+]?\\d*\\.?\\d+(?:[eE][-+]?\\d+)?)\"\n",
        "        r\"\\s*([A-Za-z]*)\"\n",
        "    )\n",
        "\n",
        "    match = re.match(pattern, s)\n",
        "\n",
        "    if not match:\n",
        "        return np.nan, \"unparsed\", \"\", np.nan\n",
        "\n",
        "    numeric_value = float(match.group(1))\n",
        "    letters = match.group(2)\n",
        "\n",
        "    # Preserve any additional statistical letters\n",
        "    # such as \"A, ab\" in the qualifier\n",
        "    remainder = s[match.end():].strip()\n",
        "\n",
        "    # Extract percentage in parentheses, if present\n",
        "    efficiency = np.nan\n",
        "\n",
        "    pct_match = re.search(\n",
        "        r\"\\(([-+]?\\d*\\.?\\d+)\\)\", remainder\n",
        "    )\n",
        "\n",
        "    if pct_match:\n",
        "        efficiency = float(pct_match.group(1))\n",
        "\n",
        "    return numeric_value, \"measured\", letters, efficiency\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 3: IDENTIFY NUMERIC MEASUREMENT COLUMNS\n",
        "# ============================================================\n",
        "\n",
        "numeric_names = {\n",
        "    \"ph\", \"om\", \"organic_matter\", \"caco3\",\n",
        "    \"wsp\", \"tp\", \"tfe\", \"tal\", \"tmg\",\n",
        "    \"total_fe\", \"total_al\", \"total_mg\",\n",
        "    \"total_p\", \"fe\", \"al\", \"mg\", \"ca\",\n",
        "    \"pb\", \"cd\", \"as\", \"cr\", \"ni\", \"cu\",\n",
        "    \"zn\", \"hg\", \"co\", \"mn\",\n",
        "    \"concentration\", \"concentration_mg_kg\",\n",
        "    \"sample_count\", \"n\"\n",
        "}\n",
        "\n",
        "numeric_prefixes = (\n",
        "    \"m1_\", \"m3_\", \"la_\",\n",
        "    \"total_\", \"extractable_\"\n",
        ")\n",
        "\n",
        "def is_measurement_column(col):\n",
        "\n",
        "    if col in numeric_names:\n",
        "        return True\n",
        "\n",
        "    if col.startswith(numeric_prefixes):\n",
        "        return True\n",
        "\n",
        "    if col.endswith((\"_mg_kg\", \"_percent\", \"_pct\")):\n",
        "        return True\n",
        "\n",
        "    return False\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 4: CLEAN ALL WORKSHEETS\n",
        "# ============================================================\n",
        "\n",
        "cleaned_sheets = {}\n",
        "quality_results = []\n",
        "flagged_records = []\n",
        "\n",
        "for sheet in excel_file.sheet_names:\n",
        "\n",
        "    print(\"\\nCleaning worksheet:\", sheet)\n",
        "\n",
        "    df = pd.read_excel(\n",
        "        file_name,\n",
        "        sheet_name=sheet,\n",
        "        dtype=object\n",
        "    )\n",
        "\n",
        "    original_rows = len(df)\n",
        "\n",
        "    # Remove completely empty rows and columns\n",
        "    df = df.dropna(how=\"all\")\n",
        "    df = df.dropna(axis=1, how=\"all\")\n",
        "\n",
        "    # Standardize column names\n",
        "    df.columns = [\n",
        "        clean_column_name(c) for c in df.columns\n",
        "    ]\n",
        "\n",
        "    # Make duplicate column names unique\n",
        "    counts = {}\n",
        "    new_columns = []\n",
        "\n",
        "    for col in df.columns:\n",
        "        counts[col] = counts.get(col, 0) + 1\n",
        "        suffix = counts[col]\n",
        "\n",
        "        new_columns.append(\n",
        "            col if suffix == 1 else f\"{col}_{suffix}\"\n",
        "        )\n",
        "\n",
        "    df.columns = new_columns\n",
        "\n",
        "    # Remove duplicate rows\n",
        "    duplicate_count = int(df.duplicated().sum())\n",
        "    df = df.drop_duplicates().reset_index(drop=True)\n",
        "\n",
        "    # Clean text fields\n",
        "    for col in df.columns:\n",
        "        if not is_measurement_column(col):\n",
        "            df[col] = df[col].apply(clean_text)\n",
        "\n",
        "    # Clean measurements\n",
        "    for col in list(df.columns):\n",
        "\n",
        "        if not is_measurement_column(col):\n",
        "            continue\n",
        "\n",
        "        parsed = df[col].apply(parse_measurement)\n",
        "\n",
        "        df[col] = parsed.apply(lambda x: x[0])\n",
        "\n",
        "        qualifiers = parsed.apply(lambda x: x[1])\n",
        "        letters = parsed.apply(lambda x: x[2])\n",
        "        efficiencies = parsed.apply(lambda x: x[3])\n",
        "\n",
        "        # Preserve scientific information when present\n",
        "        if (qualifiers != \"measured\").any():\n",
        "            df[f\"{col}_status\"] = qualifiers\n",
        "\n",
        "        if (letters != \"\").any():\n",
        "            df[f\"{col}_significance\"] = letters\n",
        "\n",
        "        if efficiencies.notna().any():\n",
        "            df[f\"{col}_efficiency_percent\"] = efficiencies\n",
        "\n",
        "        # Flag negative concentrations\n",
        "        # pH is not a concentration\n",
        "        if col != \"ph\":\n",
        "\n",
        "            negative_mask = df[col].notna() & (df[col] < 0)\n",
        "\n",
        "            for idx in df.index[negative_mask]:\n",
        "                flagged_records.append({\n",
        "                    \"worksheet\": sheet,\n",
        "                    \"excel_row_approx\": int(idx) + 2,\n",
        "                    \"column\": col,\n",
        "                    \"value\": df.loc[idx, col],\n",
        "                    \"issue\": \"Negative measurement - review\"\n",
        "                })\n",
        "\n",
        "    # Record quality metrics\n",
        "    missing_cells = int(df.isna().sum().sum())\n",
        "\n",
        "    quality_results.append({\n",
        "        \"worksheet\": sheet,\n",
        "        \"original_rows\": original_rows,\n",
        "        \"cleaned_rows\": len(df),\n",
        "        \"duplicates_removed\": duplicate_count,\n",
        "        \"missing_cells_after_cleaning\": missing_cells\n",
        "    })\n",
        "\n",
        "    cleaned_sheets[sheet] = df\n",
        "\n",
        "    print(\"Original rows:\", original_rows)\n",
        "    print(\"Cleaned rows:\", len(df))\n",
        "    print(\"Duplicates removed:\", duplicate_count)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 5: CREATE DATA QUALITY REPORT\n",
        "# ============================================================\n",
        "\n",
        "quality_report = pd.DataFrame(quality_results)\n",
        "\n",
        "flag_report = pd.DataFrame(\n",
        "    flagged_records,\n",
        "    columns=[\n",
        "        \"worksheet\",\n",
        "        \"excel_row_approx\",\n",
        "        \"column\",\n",
        "        \"value\",\n",
        "        \"issue\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "print(\"\\nDATA QUALITY SUMMARY\")\n",
        "display(quality_report)\n",
        "\n",
        "print(\"\\nFLAGGED MEASUREMENTS\")\n",
        "display(flag_report)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 6: SAVE CLEANED EXCEL WORKBOOK\n",
        "# ============================================================\n",
        "\n",
        "output_file = \"Alabama_Soil_Metals_Final_Cleaned.xlsx\"\n",
        "\n",
        "with pd.ExcelWriter(\n",
        "    output_file,\n",
        "    engine=\"openpyxl\"\n",
        ") as writer:\n",
        "\n",
        "    used_names = set()\n",
        "\n",
        "    for sheet_name, df in cleaned_sheets.items():\n",
        "\n",
        "        safe_name = sheet_name[:31]\n",
        "        base = safe_name\n",
        "        counter = 1\n",
        "\n",
        "        while safe_name.lower() in used_names:\n",
        "            suffix = f\"_{counter}\"\n",
        "            safe_name = base[:31-len(suffix)] + suffix\n",
        "            counter += 1\n",
        "\n",
        "        used_names.add(safe_name.lower())\n",
        "\n",
        "        df.to_excel(\n",
        "            writer,\n",
        "            sheet_name=safe_name,\n",
        "            index=False\n",
        "        )\n",
        "\n",
        "    quality_report.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Cleaning_Report\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    flag_report.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Flagged_Values\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 7: DOWNLOAD CLEANED FILE\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n========================================\")\n",
        "print(\"DATA CLEANING COMPLETED SUCCESSFULLY\")\n",
        "print(\"========================================\")\n",
        "print(\"Output file:\", output_file)\n",
        "\n",
        "files.download(output_file)\n"

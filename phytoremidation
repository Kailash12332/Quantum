      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# 1. Standardize Calhoun data for summary\n",
        "cal_summary = calhoun_wide.copy()\n",
        "cal_summary['county'] = 'Calhoun'\n",
        "\n",
        "# 2. Standardize Macon data for summary\n",
        "mac_summary = macon_long.copy()  # Using long data for Macon since its wide variable only contained missing value summaries\n",
        "mac_summary['county'] = 'Macon'\n",
        "mac_summary = mac_summary.rename(columns={'as_mg_kg': 'as_mgkg', 'co_mg_kg': 'co_mgkg', 'pb_mg_kg': 'pb_mgkg'})\n",
        "\n",
        "# 3. Standardize Mobile data for summary\n",
        "mob_summary = mobile_wide.copy()\n",
        "mob_summary['county'] = 'Mobile'\n",
        "\n",
        "# 4. Standardize Jefferson data for summary\n",
        "jef_summary = jefferson_data.copy()\n",
        "jef_summary['county'] = 'Jefferson'\n",
        "jef_summary = jef_summary.rename(columns={'as_mgkg': 'as_mgkg', 'co_mgkg': 'co_mgkg', 'pb_mgkg': 'pb_mgkg'})\n",
        "\n",
        "# Align matching columns and concatenate\n",
        "columns_to_keep = ['county', 'sample_id', 'as_mgkg', 'co_mgkg', 'pb_mgkg']\n",
        "all_dfs = []\n",
        "\n",
        "for name, df_sub in [('Calhoun', cal_summary), ('Macon', mac_summary), ('Mobile', mob_summary), ('Jefferson', jef_summary)]:\n",
        "    # Keep only columns that exist\n",
        "    valid_cols = [col for col in columns_to_keep if col in df_sub.columns]\n",
        "    temp = df_sub[valid_cols].copy()\n",
        "    if 'county' not in temp.columns:\n",
        "        temp['county'] = name\n",
        "    all_dfs.append(temp)\n",
        "\n",
        "summary_df = pd.concat(all_dfs, ignore_index=True)\n",
        "\n",
        "# Numeric conversion\n",
        "for col in ['as_mgkg', 'co_mgkg', 'pb_mgkg']:\n",
        "    if col in summary_df.columns:\n",
        "        summary_df[col] = pd.to_numeric(summary_df[col], errors='coerce')\n",
        "\n",
        "# Compute summary metrics grouped by County\n",
        "county_grouped_summary = summary_df.groupby('county').agg(\n",
        "    sample_count=('sample_id', 'nunique'),\n",
        "    mean_arsenic=('as_mgkg', 'mean'),\n",
        "    max_arsenic=('as_mgkg', 'max'),\n",
        "    mean_cobalt=('co_mgkg', 'mean'),\n",
        "    max_cobalt=('co_mgkg', 'max'),\n",
        "    mean_lead=('pb_mgkg', 'mean'),\n",
        "    max_lead=('pb_mgkg', 'max')\n",
        ").round(2)\n",
        "\n",
        "print(\"=== Consolidated 4-County Heavy Metals Summary ===\")\n",
        "display(county_grouped_summary)\n"
      ],

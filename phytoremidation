      "cell_type": "code",
      "source": [
        "\n",
        "# ============================================================\n",
        "# ALABAMA SOIL CHEMISTRY - PUBLICATION-STYLE FIGURES\n",
        "# Source: Bhatta et al. (2021)\n",
        "# Google Colab - Complete plotting script\n",
        "# ============================================================\n",
        "\n",
        "!pip -q install pandas openpyxl matplotlib seaborn\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import os\n",
        "import re\n",
        "import zipfile\n",
        "from google.colab import files\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. UPLOAD WORKBOOK\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"Upload your Alabama soil statistical Excel workbook\")\n",
        "uploaded = files.upload()\n",
        "filename = next(iter(uploaded))\n",
        "\n",
        "xls = pd.ExcelFile(filename)\n",
        "print(\"Worksheets:\", xls.sheet_names)\n",
        "\n",
        "for name in xls.sheet_names:\n",
        "    preview = pd.read_excel(filename, sheet_name=name)\n",
        "    print(f\"\\n{name}: {preview.shape}\")\n",
        "    print(preview.columns.tolist())\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. PUBLISHED TABLE 2 VALUES\n",
        "#    Used to guarantee that plots retain the correct\n",
        "#    soil region, depth, and concentration units.\n",
        "#    All metal values are published group means (mg/kg).\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "records = [\n",
        "    # Region, depth, pH, WSP, TP, Fe, Al, Mg\n",
        "    (\"Appalachian Plateau\", \"0-5\", 5.9,10.8,625,12157,13942,770),\n",
        "    (\"Appalachian Plateau\", \"5-15\",5.8,3.4,422,12449,14306,740),\n",
        "    (\"Appalachian Plateau\", \"15-30\",5.6,1.4,275,14541,18337,875),\n",
        "    (\"Appalachian Plateau\", \"30-45\",5.4,0.5,175,16237,20745,935),\n",
        "\n",
        "    (\"Coastal Plain\", \"0-5\",5.8,8.2,314,7747,13376,333),\n",
        "    (\"Coastal Plain\", \"5-15\",5.8,5.4,236,8526,14994,310),\n",
        "    (\"Coastal Plain\", \"15-30\",5.7,3.3,204,12131,21890,407),\n",
        "    (\"Coastal Plain\", \"30-45\",5.6,1.2,143,16159,29566,543),\n",
        "\n",
        "    (\"Limestone Valley\", \"0-5\",6.2,6.7,541,19066,21193,1037),\n",
        "    (\"Limestone Valley\", \"5-15\",6.1,1.4,348,20044,23637,1052),\n",
        "    (\"Limestone Valley\", \"15-30\",6.0,0.4,269,22258,29216,1274),\n",
        "    (\"Limestone Valley\", \"30-45\",5.7,0.3,210,24627,31619,1391),\n",
        "\n",
        "    (\"Piedmont Plateau\", \"0-5\",5.5,7.4,694,29444,26323,819),\n",
        "    (\"Piedmont Plateau\", \"5-15\",5.3,3.1,453,33753,30769,804),\n",
        "    (\"Piedmont Plateau\", \"15-30\",5.2,1.2,327,38549,39190,934),\n",
        "    (\"Piedmont Plateau\", \"30-45\",5.3,0.3,273,39723,40349,994),\n",
        "\n",
        "    (\"Blackland Prairie\", \"0-5\",7.4,2.6,823,23061,25129,2149),\n",
        "    (\"Blackland Prairie\", \"5-15\",7.6,0.9,499,24929,26596,2092),\n",
        "    (\"Blackland Prairie\", \"15-30\",7.5,0.3,334,26693,29733,2142),\n",
        "    (\"Blackland Prairie\", \"30-45\",7.4,0.1,293,29400,33398,2308)\n",
        "]\n",
        "\n",
        "columns = [\n",
        "    \"Region\", \"Depth\", \"pH\", \"WSP\", \"Total_P\",\n",
        "    \"Total_Fe\", \"Total_Al\", \"Total_Mg\"\n",
        "]\n",
        "\n",
        "df = pd.DataFrame(records, columns=columns)\n",
        "\n",
        "regions = [\n",
        "    \"Appalachian Plateau\",\n",
        "    \"Coastal Plain\",\n",
        "    \"Limestone Valley\",\n",
        "    \"Piedmont Plateau\",\n",
        "    \"Blackland Prairie\"\n",
        "]\n",
        "\n",
        "depths = [\"0-5\", \"5-15\", \"15-30\", \"30-45\"]\n",
        "\n",
        "df[\"Region\"] = pd.Categorical(\n",
        "    df[\"Region\"], categories=regions, ordered=True\n",
        ")\n",
        "\n",
        "df[\"Depth\"] = pd.Categorical(\n",
        "    df[\"Depth\"], categories=depths, ordered=True\n",
        ")\n",
        "\n",
        "# Published combined-depth means (not averages recomputed\n",
        "# from the four rounded depth means)\n",
        "combined = pd.DataFrame({\n",
        "    \"Region\": regions,\n",
        "    \"pH\": [5.7, 5.7, 6.0, 5.4, 7.5],\n",
        "    \"Total_Fe\": [13874,11204,21406,35147,26021],\n",
        "    \"Total_Al\": [16882,20080,26234,33841,28714],\n",
        "    \"Total_Mg\": [832,399,1182,882,2173]\n",
        "})\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. FIGURE SETTINGS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "sns.set_theme(style=\"whitegrid\", context=\"paper\")\n",
        "\n",
        "plt.rcParams.update({\n",
        "    \"font.size\": 11,\n",
        "    \"axes.titlesize\": 13,\n",
        "    \"axes.labelsize\": 11,\n",
        "    \"figure.dpi\": 120,\n",
        "    \"savefig.dpi\": 300,\n",
        "    \"axes.spines.top\": False,\n",
        "    \"axes.spines.right\": False\n",
        "})\n",
        "\n",
        "output_dir = \"Alabama_Soil_Figures\"\n",
        "os.makedirs(output_dir, exist_ok=True)\n",
        "\n",
        "def save_plot(name):\n",
        "    plt.savefig(\n",
        "        os.path.join(output_dir, name),\n",
        "        dpi=300,\n",
        "        bbox_inches=\"tight\"\n",
        "    )\n",
        "    plt.show()\n",
        "    plt.close()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# FIGURE 1: TOTAL Fe AND Al BY SOIL REGION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(11,6))\n",
        "\n",
        "plot_df = combined.melt(\n",
        "    id_vars=\"Region\",\n",
        "    value_vars=[\"Total_Fe\", \"Total_Al\"],\n",
        "    var_name=\"Metal\",\n",
        "    value_name=\"Concentration\"\n",
        ")\n",
        "\n",
        "sns.barplot(\n",
        "    data=plot_df,\n",
        "    x=\"Region\",\n",
        "    y=\"Concentration\",\n",
        "    hue=\"Metal\",\n",
        "    palette=[\"#2878B5\", \"#E69F00\"],\n",
        "    errorbar=None,\n",
        "    ax=ax\n",
        ")\n",
        "\n",
        "ax.set_title(\n",
        "    \"Total Fe and Al Concentrations Across Alabama Soil Regions\"\n",
        ")\n",
        "ax.set_ylabel(\"Mean concentration (mg/kg)\")\n",
        "ax.set_xlabel(\"\")\n",
        "ax.tick_params(axis=\"x\", rotation=25)\n",
        "ax.legend(title=\"Metal\")\n",
        "plt.tight_layout()\n",
        "\n",
        "save_plot(\"Figure_1_Fe_Al_Regional_Barplot.png\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# FIGURE 2: SOIL CHEMISTRY HEATMAP\n",
        "# Standardize each variable only for visualization\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "heat_data = combined.set_index(\"Region\")[\n",
        "    [\"pH\", \"Total_Fe\", \"Total_Al\", \"Total_Mg\"]\n",
        "]\n",
        "\n",
        "heat_scaled = (\n",
        "    heat_data - heat_data.mean()\n",
        ") / heat_data.std(ddof=0)\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(9,6))\n",
        "\n",
        "sns.heatmap(\n",
        "    heat_scaled,\n",
        "    cmap=\"RdBu_r\",\n",
        "    center=0,\n",
        "    annot=True,\n",
        "    fmt=\".2f\",\n",
        "    linewidths=0.6,\n",
        "    cbar_kws={\"label\": \"Standardized value (z-score)\"},\n",
        "    ax=ax\n",
        ")\n",
        "\n",
        "ax.set_title(\n",
        "    \"Standardized Soil Chemistry Across Alabama Soil Regions\"\n",
        ")\n",
        "ax.set_xlabel(\"\")\n",
        "ax.set_ylabel(\"\")\n",
        "plt.tight_layout()\n",
        "\n",
        "save_plot(\"Figure_2_Soil_Chemistry_Heatmap.png\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# FIGURE 3: SOIL DEPTH PROFILES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "fig, axes = plt.subplots(1,3,figsize=(16,6))\n",
        "\n",
        "metals = [\"Total_Fe\", \"Total_Al\", \"Total_Mg\"]\n",
        "titles = [\"Iron (Fe)\", \"Aluminum (Al)\", \"Magnesium (Mg)\"]\n",
        "\n",
        "depth_mid = {\n",
        "    \"0-5\": 2.5,\n",
        "    \"5-15\": 10,\n",
        "    \"15-30\": 22.5,\n",
        "    \"30-45\": 37.5\n",
        "}\n",
        "\n",
        "df[\"Depth_mid_cm\"] = df[\"Depth\"].astype(str).map(depth_mid)\n",
        "\n",
        "for ax, metal, title in zip(axes, metals, titles):\n",
        "\n",
        "    for region in regions:\n",
        "        subset = df[df[\"Region\"] == region]\n",
        "\n",
        "        ax.plot(\n",
        "            subset[metal],\n",
        "            subset[\"Depth_mid_cm\"],\n",
        "            marker=\"o\",\n",
        "            linewidth=2,\n",
        "            label=region\n",
        "        )\n",
        "\n",
        "    ax.invert_yaxis()\n",
        "    ax.set_title(title)\n",
        "    ax.set_xlabel(\"Concentration (mg/kg)\")\n",
        "    ax.set_ylabel(\"Soil depth (cm)\")\n",
        "    ax.grid(alpha=0.3)\n",
        "\n",
        "handles, labels = axes[0].get_legend_handles_labels()\n",
        "\n",
        "fig.legend(\n",
        "    handles,\n",
        "    labels,\n",
        "    loc=\"lower center\",\n",
        "    ncol=3,\n",
        "    bbox_to_anchor=(0.5,-0.04)\n",
        ")\n",
        "\n",
        "fig.suptitle(\n",
        "    \"Vertical Distribution of Soil Metals Across Alabama Regions\",\n",
        "    fontsize=15\n",
        ")\n",
        "\n",
        "plt.tight_layout(rect=[0,0.08,1,0.95])\n",
        "\n",
        "save_plot(\"Figure_3_Metal_Depth_Profiles.png\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# FIGURE 4: CORRELATION HEATMAP\n",
        "# Descriptive only: n=5 regional combined-depth means\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "correlation = combined[\n",
        "    [\"pH\",\"Total_Fe\",\"Total_Al\",\"Total_Mg\"]\n",
        "].corr(method=\"pearson\")\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(8,6))\n",
        "\n",
        "sns.heatmap(\n",
        "    correlation,\n",
        "    annot=True,\n",
        "    fmt=\".2f\",\n",
        "    cmap=\"coolwarm\",\n",
        "    vmin=-1,\n",
        "    vmax=1,\n",
        "    center=0,\n",
        "    square=True,\n",
        "    linewidths=0.5,\n",
        "    cbar_kws={\"label\":\"Pearson correlation (r)\"},\n",
        "    ax=ax\n",
        ")\n",
        "\n",
        "ax.set_title(\n",
        "    \"Exploratory Correlation of Regional Soil Chemistry (n=5)\"\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "save_plot(\"Figure_4_Correlation_Heatmap.png\")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# FIGURE 5: MEHLICH 1 VS MEHLICH 3 EXTRACTABLE Fe\n",
        "# Published combined-depth means, Table 3\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "extractable = pd.DataFrame({\n",
        "    \"Region\": regions[:4],\n",
        "    \"M1_Fe\": [44,17,19,39],\n",
        "    \"M3_Fe\": [192,79,95,173]\n",
        "})\n",
        "\n",
        "extract_long = extractable.melt(\n",
        "    id_vars=\"Region\",\n",
        "    value_vars=[\"M1_Fe\",\"M3_Fe\"],\n",
        "    var_name=\"Extraction Method\",\n",
        "    value_name=\"Extractable Fe\"\n",
        ")\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(10,6))\n",
        "\n",
        "sns.barplot(\n",
        "    data=extract_long,\n",
        "    x=\"Region\",\n",
        "    y=\"Extractable Fe\",\n",
        "    hue=\"Extraction Method\",\n",
        "    palette=[\"#4C78A8\",\"#F58518\"],\n",
        "    errorbar=None,\n",
        "    ax=ax\n",
        ")\n",
        "\n",
        "ax.set_title(\n",
        "    \"Mehlich 1 vs Mehlich 3 Extractable Iron\"\n",
        ")\n",
        "ax.set_ylabel(\"Mean extractable Fe (mg/kg)\")\n",
        "ax.set_xlabel(\"\")\n",
        "ax.tick_params(axis=\"x\",rotation=20)\n",
        "ax.legend(title=\"Method\")\n",
        "plt.tight_layout()\n",
        "\n",

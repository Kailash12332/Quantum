        "# Prepare the data for plotting\n",
        "plot_data = summary_df.copy()\n",
        "\n",
        "# Melt the dataframe to wide-to-long format for easy plotting with seaborn\n",
        "melted_df = plot_data.melt(id_vars=['county'], value_vars=['as_mgkg', 'co_mgkg', 'pb_mgkg'],\n",
